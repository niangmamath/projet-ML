# === Model registry (Phase B) ===
# Repo HuggingFace Hub contenant les 24 checkpoints LTSF.
# Si vous forkez, pointez ces variables vers VOTRE propre repo.
MODEL_REPO_ID=Momoniang/ltsf-transformers-etth1
MODEL_VERSION=v1.0.0

# Token HF (optionnel si MODEL_REPO_ID est public). Sur HF Spaces, declarer
# plutot dans Settings > Secrets, pas ici.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# === Monitoring DB (Phase C, pas encore active) ===
# Postgres pour logger predictions + drift. Un des deux noms est accepte.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# DATA_POSTGRESQL=postgresql://user:pass@host/db?sslmode=require
